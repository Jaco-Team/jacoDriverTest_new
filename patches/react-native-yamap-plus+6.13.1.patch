 @implementation RTNYamapModule
 
+// System journal only. These methods never change MapKit or JS store state.
+- (void)logOfflineMapState:(NSString *)snapshot {
+    @try {
+        if (snapshot.length <= 4096) NSLog(@"[JacoOfflineMapUI] %@", snapshot);
+    } @catch (__unused NSException *exception) {}
+}
+
+- (void)journalOffline:(NSString *)key payload:(NSDictionary *)payload {
+    @try {
+        NSString *snapshot = offlineJSON(payload);
+        if (!self.offlineJournalSnapshots) self.offlineJournalSnapshots = [NSMutableDictionary dictionary];
+        if (![self.offlineJournalSnapshots[key] isEqualToString:snapshot]) {
+            self.offlineJournalSnapshots[key] = snapshot;
+            NSLog(@"[JacoOfflineMap] %@", snapshot);
+        }
+    } @catch (__unused NSException *exception) {}
+}
+
+- (void)journalOfflineRegion:(NSUInteger)regionId {
+    @try {
+        YMKOfflineCacheManager *manager = [YMKMapKit sharedInstance].offlineCacheManager;
+        NSDate *installed = [manager getDownloadedReleaseTimeWithRegionId:regionId];
+        NSDate *available = nil;
+        for (YMKOfflineCacheRegion *region in [manager regions]) {
+            if (region.id == regionId) { available = region.releaseTime; break; }
+        }
+        [self journalOffline:[NSString stringWithFormat:@"sdk:%lu", (unsigned long)regionId] payload:@{
+            @"event": @"sdk_state", @"regionId": @(regionId),
+            @"state": offlineRegionStateName([manager getStateWithRegionId:regionId]),
+            @"downloadedReleaseTime": installed ? @(installed.timeIntervalSince1970 * 1000.0) : [NSNull null],
+            @"availableReleaseTime": available ? @(available.timeIntervalSince1970 * 1000.0) : [NSNull null],
+            @"catalogUpdated": @(self.offlineCatalogUpdated)
+        }];
+    } @catch (__unused NSException *exception) {}
+}
+
+- (void)recordOfflineState:(YMKOfflineCacheManager *)manager regionId:(NSUInteger)regionId {
+    if (![self.offlineRequestedDownloads containsObject:@(regionId)]) return;
+    YMKOfflineCacheRegionState state = [manager getStateWithRegionId:regionId];
+    if (state == YMKOfflineCacheRegionStateDownloading) {
+        [self.offlineStartedDownloads addObject:@(regionId)];
+        [self.offlineActiveDownloads addObject:@(regionId)];
+    } else if (state == YMKOfflineCacheRegionStatePaused) {
+        [self.offlineActiveDownloads removeObject:@(regionId)];
+    } else if (state == YMKOfflineCacheRegionStateCompleted) {
+        NSDate *installed = [manager getDownloadedReleaseTimeWithRegionId:regionId];
+        NSDate *available = nil;
+        for (YMKOfflineCacheRegion *region in [manager regions]) {
+            if (region.id == regionId) { available = region.releaseTime; break; }
+        }
+        if ([self.offlineStartedDownloads containsObject:@(regionId)] ||
+            (installed && available && [installed compare:available] != NSOrderedAscending)) {
+            [self.offlineActiveDownloads removeObject:@(regionId)];
+        }
+    }
+}
+
+- (void)onRegionStateChangedWithRegionId:(NSUInteger)regionId {
+    [self recordOfflineState:[YMKMapKit sharedInstance].offlineCacheManager regionId:regionId];
+    [self journalOfflineRegion:regionId];
+}
+
+- (void)onRegionProgressWithRegionId:(NSUInteger)regionId {
+    [self recordOfflineState:[YMKMapKit sharedInstance].offlineCacheManager regionId:regionId];
+}
+
+- (void)watchOfflineCatalog:(YMKOfflineCacheManager *)manager {
+    if (!self.offlineListenersAdded) {
+        [manager addRegionListUpdatesListenerWithRegionListUpdatesListener:self];
+        [manager addErrorListenerWithErrorListener:self];
+        [manager addRegionListenerWithRegionListener:self];
+        self.offlineRequestedDownloads = [NSMutableSet set];
+        self.offlineActiveDownloads = [NSMutableSet set];
+        self.offlineStartedDownloads = [NSMutableSet set];
+        self.offlineListenersAdded = YES;
+    }
+}
+
+- (void)onListUpdated {
+    self.offlineCatalogUpdated = YES;
+    self.offlineCatalogError = nil;
+}
+
+- (void)onErrorWithError:(NSError *)error {
+    self.offlineCatalogError = error.localizedDescription;
+    for (NSNumber *regionId in [self.offlineActiveDownloads allObjects]) {
+        [self onRegionErrorWithError:error regionId:regionId.unsignedIntegerValue];
+    }
+}
+
+- (void)onRegionErrorWithError:(NSError *)error regionId:(NSUInteger)regionId {
+    if (!self.offlineRegionErrors) self.offlineRegionErrors = [NSMutableDictionary dictionary];
+    self.offlineRegionErrors[@(regionId)] = error.localizedDescription;
+    if (!self.offlineErrorReleases) self.offlineErrorReleases = [NSMutableDictionary dictionary];
+    NSDate *release = [[YMKMapKit sharedInstance].offlineCacheManager getDownloadedReleaseTimeWithRegionId:regionId];
+    if (release) self.offlineErrorReleases[@(regionId)] = release;
+    else [self.offlineErrorReleases removeObjectForKey:@(regionId)];
+    [self.offlineActiveDownloads removeObject:@(regionId)];
+}
