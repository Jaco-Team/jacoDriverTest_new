+static NSString *offlineRegionStateName(YMKOfflineCacheRegionState state) {
+    switch (state) {
+        case YMKOfflineCacheRegionStateAvailable: return @"available";
+        case YMKOfflineCacheRegionStateDownloading: return @"downloading";
+        case YMKOfflineCacheRegionStatePaused: return @"paused";
+        case YMKOfflineCacheRegionStateCompleted: return @"completed";
+        case YMKOfflineCacheRegionStateOutdated: return @"outdated";
+        case YMKOfflineCacheRegionStateUnsupported: return @"unsupported";
+        case YMKOfflineCacheRegionStateNeedUpdate: return @"need_update";
+    }
+    return @"unknown";
+}
+
+static NSString *offlineJSON(id object) {
+    NSData *data = [NSJSONSerialization dataWithJSONObject:object options:0 error:nil];
+    return data ? [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding] : @"[]";
+}
+
+@interface RTNYamapModule () <YMKOfflineMapRegionListUpdatesListener, YMKOfflineCacheManagerErrorListener, YMKOfflineCacheRegionListener>
+@property (nonatomic, strong) NSMutableSet<NSNumber *> *offlineRequestedDownloads;
+@property (nonatomic, strong) NSMutableSet<NSNumber *> *offlineActiveDownloads;
+@property (nonatomic, strong) NSMutableSet<NSNumber *> *offlineStartedDownloads;
+@property (nonatomic, strong) NSMutableDictionary<NSString *, NSString *> *offlineJournalSnapshots;
+@property (nonatomic, assign) BOOL offlineListenersAdded;
+@property (nonatomic, assign) BOOL offlineCatalogUpdated;
+@property (nonatomic, copy) NSString *offlineCatalogError;
+@property (nonatomic, strong) NSMutableDictionary<NSNumber *, NSString *> *offlineRegionErrors;
+@property (nonatomic, strong) NSMutableDictionary<NSNumber *, NSDate *> *offlineErrorReleases;
+@end
