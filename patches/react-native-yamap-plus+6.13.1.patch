+- (void)getKnownOfflineRegions:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject {
+    @try {
+        YMKOfflineCacheManager *manager = [YMKMapKit sharedInstance].offlineCacheManager;
+        [self watchOfflineCatalog:manager];
+        NSMutableArray *regions = [NSMutableArray array];
+        for (YMKOfflineCacheRegion *region in [manager regions]) {
+            [regions addObject:@{@"id": @(region.id), @"name": region.name, @"sizeBytes": @(region.size.value)}];
+        }
+        [self journalOffline:@"catalog" payload:@{
+            @"event": @"catalog_read", @"count": @(regions.count),
+            @"catalogUpdated": @(self.offlineCatalogUpdated)
+        }];
+        resolve(offlineJSON(regions));
+    } @catch (NSException *exception) {
+        reject(@"YANDEX_OFFLINE_STATUS", exception.reason, nil);
+    }
+}
+
+- (void)getOfflineRegionsAtPoint:(double)latitude longitude:(double)longitude resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject {
+    @try {
+        YMKOfflineCacheManager *manager = [YMKMapKit sharedInstance].offlineCacheManager;
+        [self watchOfflineCatalog:manager];
+        YMKPoint *point = [YMKPoint pointWithLatitude:latitude longitude:longitude];
+        [manager requestRegionsAtPointWithPoint:point regionsAtPointCallback:^(NSArray<NSNumber *> *regions, NSError *error) {
+            if (error) {
+                reject(@"YANDEX_OFFLINE_REGIONS", error.localizedDescription, error);
+                return;
+            }
+            @try {
+                NSMutableDictionary<NSNumber *, YMKOfflineCacheRegion *> *known = [NSMutableDictionary dictionary];
+                for (YMKOfflineCacheRegion *region in [manager regions]) {
+                    known[@(region.id)] = region;
+                }
+                NSMutableArray *result = [NSMutableArray array];
+                for (NSNumber *regionId in regions ?: @[]) {
+                    NSMutableDictionary *item = [@{
+                        @"id": regionId,
+                        @"name": known[regionId].name ?: [NSString stringWithFormat:@"Регион %@", regionId],
+                        @"catalogCount": @(known.count),
+                        @"catalogUpdated": @(self.offlineCatalogUpdated)
+                    } mutableCopy];
+                    if (self.offlineCatalogError) {
+                        item[@"catalogError"] = self.offlineCatalogError;
+                    }
+                    if (known[regionId]) {
+                        item[@"sizeBytes"] = @(known[regionId].size.value);
+                    }
+                    [result addObject:item];
+                }
+                resolve(offlineJSON(result));
+            } @catch (NSException *exception) {
+                reject(@"YANDEX_OFFLINE_REGIONS", exception.reason, nil);
+            }
+        }];
+    } @catch (NSException *exception) {
+        reject(@"YANDEX_OFFLINE_REGIONS", exception.reason, nil);
+    }
+}
+
+- (void)getOfflineRegionStatus:(double)regionId resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject {
+    @try {
+        YMKOfflineCacheManager *manager = [YMKMapKit sharedInstance].offlineCacheManager;
+        [self watchOfflineCatalog:manager];
+        NSUInteger value = (NSUInteger)regionId;
+        [self recordOfflineState:manager regionId:value];
+        YMKOfflineCacheRegionState state = [manager getStateWithRegionId:value];
+        NSArray<YMKOfflineCacheRegion *> *regions = [manager regions];
+        // An empty startup catalog makes unsupported provisional, not a missing package.
+        BOOL stateKnown = state != YMKOfflineCacheRegionStateUnsupported || self.offlineCatalogUpdated || regions.count > 0;
+        NSDate *availableRelease = nil;
+        for (YMKOfflineCacheRegion *region in regions) {
+            if (region.id == value) { availableRelease = region.releaseTime; break; }
+        }
+        NSDate *release = [manager getDownloadedReleaseTimeWithRegionId:value];
+        // A completed old package does not mean its update succeeded.
+        if ((state == YMKOfflineCacheRegionStateCompleted || state == YMKOfflineCacheRegionStateOutdated) &&
+            release && self.offlineRegionErrors[@(value)] &&
+            ![release isEqual:self.offlineErrorReleases[@(value)]]) {
+            [self.offlineRegionErrors removeObjectForKey:@(value)];
+            [self.offlineErrorReleases removeObjectForKey:@(value)];
+        }
+        NSMutableDictionary *status = [@{
+            @"id": @(value),
+            @"state": offlineRegionStateName(state),
+            @"stateKnown": @(stateKnown),
+            @"progress": @([manager getProgressWithRegionId:value])
+        } mutableCopy];
+        status[@"downloadedReleaseTime"] = release ? @(release.timeIntervalSince1970 * 1000.0) : [NSNull null];
+        status[@"availableReleaseTime"] = availableRelease ? @(availableRelease.timeIntervalSince1970 * 1000.0) : [NSNull null];
+        status[@"downloadStarted"] = @([self.offlineStartedDownloads containsObject:@(value)]);
+        if (self.offlineRegionErrors[@(value)]) status[@"error"] = self.offlineRegionErrors[@(value)];
+        NSMutableDictionary *journal = [status mutableCopy];
+        journal[@"event"] = @"status_returned";
+        journal[@"catalogUpdated"] = @(self.offlineCatalogUpdated);
+        [self journalOffline:[NSString stringWithFormat:@"status:%lu", (unsigned long)value] payload:journal];
+        resolve(offlineJSON(status));
+    } @catch (NSException *exception) {
+        reject(@"YANDEX_OFFLINE_STATUS", exception.reason, nil);
+    }
+}
+
+- (void)startOfflineRegionDownload:(double)regionId resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject {
+    @try {
+        YMKOfflineCacheManager *manager = [YMKMapKit sharedInstance].offlineCacheManager;
+        [self watchOfflineCatalog:manager];
+        NSUInteger value = (NSUInteger)regionId;
+        if ([manager mayBeOutOfAvailableSpaceWithRegionId:value]) {
+            reject(@"YANDEX_OFFLINE_SPACE", @"Недостаточно свободного места", nil);
+            return;
+        }
+        [self.offlineRegionErrors removeObjectForKey:@(value)];
+        [self.offlineErrorReleases removeObjectForKey:@(value)];
+        [manager allowUseCellularNetworkWithUseCellular:YES];
+        [self.offlineStartedDownloads removeObject:@(value)];
+        [self.offlineRequestedDownloads addObject:@(value)];
+        [self.offlineActiveDownloads addObject:@(value)];
+        [manager startDownloadWithRegionId:value];
+        [self recordOfflineState:manager regionId:value];
+        resolve(nil);
+    } @catch (NSException *exception) {
+        [self.offlineRequestedDownloads removeObject:@((NSUInteger)regionId)];
+        [self.offlineActiveDownloads removeObject:@((NSUInteger)regionId)];
+        reject(@"YANDEX_OFFLINE_DOWNLOAD", exception.reason, nil);
+    }
+}
+
+- (void)pauseOfflineRegionDownload:(double)regionId resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject {
+    @try {
+        [self.offlineActiveDownloads removeObject:@((NSUInteger)regionId)];
+        [self.offlineRequestedDownloads removeObject:@((NSUInteger)regionId)];
+        [[YMKMapKit sharedInstance].offlineCacheManager pauseDownloadWithRegionId:(NSUInteger)regionId];
+        resolve(nil);
+    } @catch (NSException *exception) {
+        reject(@"YANDEX_OFFLINE_PAUSE", exception.reason, nil);
+    }
+}
+
+- (void)removeOfflineRegion:(double)regionId resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject {
+    @try {
+        [[YMKMapKit sharedInstance].offlineCacheManager dropWithRegionId:(NSUInteger)regionId];
+        [self.offlineRegionErrors removeObjectForKey:@((NSUInteger)regionId)];
+        [self.offlineErrorReleases removeObjectForKey:@((NSUInteger)regionId)];
+        [self.offlineActiveDownloads removeObject:@((NSUInteger)regionId)];
+        [self.offlineStartedDownloads removeObject:@((NSUInteger)regionId)];
+        [self.offlineRequestedDownloads removeObject:@((NSUInteger)regionId)];
+        resolve(nil);
+    } @catch (NSException *exception) {
+        reject(@"YANDEX_OFFLINE_REMOVE", exception.reason, nil);
+    }
+}
+
 RCT_EXPORT_MODULE()
 
 @end
