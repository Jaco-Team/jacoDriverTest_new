+                put("requestActive", offlineActiveDownloads.contains(id))
+                offlineRegionErrors[id]?.let { put("error", it) }
+                offlineCatalogError?.let { put("catalogError", it) }
+            }
+            val snapshot = details.toString()
+            if (force || offlineLogSnapshots[id] != snapshot) {
+                offlineLogSnapshots[id] = snapshot
+                details.put("event", event)
