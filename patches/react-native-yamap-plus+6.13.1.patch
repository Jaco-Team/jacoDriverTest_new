+    override fun getKnownOfflineRegions(promise: Promise) {
+        UiThreadUtil.runOnUiThread {
+            try {
+                val manager = MapKitFactory.getInstance().offlineCacheManager
+                watchOfflineCatalog(manager)
+                val regions = JSONArray()
+                manager.regions().forEach { region ->
+                    regions.put(JSONObject().apply {
+                        put("id", region.id)
+                        put("name", region.name)
+                        put("sizeBytes", region.size.value)
+                    })
+                }
+                promise.resolve(regions.toString())
+            } catch (error: Throwable) {
+                promise.reject("YANDEX_OFFLINE_STATUS", error)
+            }
+        }
+    }
+
+    override fun getOfflineRegionsAtPoint(latitude: Double, longitude: Double, promise: Promise) {
+        UiThreadUtil.runOnUiThread {
+            try {
+                val manager = MapKitFactory.getInstance().offlineCacheManager
+                watchOfflineCatalog(manager)
+                manager.requestRegionsAtPoint(Point(latitude, longitude), object : RegionsAtPointListener {
+                    override fun onRegions(regionIds: MutableList<Int>) {
+                        try {
+                            val known = manager.regions().associateBy { it.id }
+                            val result = JSONArray()
+                            regionIds.forEach { id ->
+                                result.put(JSONObject().apply {
+                                    put("id", id)
+                                    put("name", known[id]?.name ?: "Регион $id")
+                                    put("catalogCount", known.size)
+                                    put("catalogUpdated", offlineCatalogUpdated)
+                                    offlineCatalogError?.let { put("catalogError", it) }
+                                    known[id]?.let { put("sizeBytes", it.size.value) }
+                                })
+                            }
+                            promise.resolve(result.toString())
+                        } catch (error: Throwable) {
