+    private fun recordOfflineState(manager: OfflineCacheManager, id: Int) {
+        if (!offlineRequestedDownloads.contains(id)) return
+        when (manager.getState(id).name.lowercase()) {
+            "downloading" -> {
+                offlineStartedDownloads.add(id)
+                offlineActiveDownloads.add(id)
+            }
+            "paused" -> offlineActiveDownloads.remove(id)
+            "completed" -> {
+                val installed = manager.getDownloadedReleaseTime(id)
+                val available = manager.regions().firstOrNull { it.id == id }?.releaseTime
+                if (offlineStartedDownloads.contains(id) ||
+                    (installed != null && available != null && installed >= available)) {
+                    offlineActiveDownloads.remove(id)
+                }
+            }
+        }
+    }
