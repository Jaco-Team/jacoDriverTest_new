+    override fun getOfflineRegionStatus(regionId: Double, promise: Promise) {
+        UiThreadUtil.runOnUiThread {
+            try {
+                val manager = MapKitFactory.getInstance().offlineCacheManager
+                watchOfflineCatalog(manager)
+                val id = regionId.toInt()
+                recordOfflineState(manager, id)
+                val state = manager.getState(id).name.lowercase()
+                val regions = manager.regions()
+                // An empty startup catalog makes unsupported provisional, not a missing package.
+                val stateKnown = state != "unsupported" || offlineCatalogUpdated || regions.isNotEmpty()
+                val availableRelease = regions.firstOrNull { it.id == id }?.releaseTime
+                val release = manager.getDownloadedReleaseTime(id)
+                // An old installed map can remain completed after an update fails.
+                // Clear the failure only when a different release is installed.
+                if ((state == "completed" || state == "outdated") &&
+                    release != null && offlineRegionErrors.containsKey(id) &&
+                    release != offlineErrorReleases[id]) {
+                    offlineRegionErrors.remove(id)
+                    offlineErrorReleases.remove(id)
+                }
+                logOfflineEvent(manager, id, "status")
+                promise.resolve(JSONObject().apply {
+                    put("downloadedReleaseTime", release ?: JSONObject.NULL)
+                    put("availableReleaseTime", availableRelease ?: JSONObject.NULL)
+                    put("downloadStarted", offlineStartedDownloads.contains(id))
+                    put("id", id)
+                    put("state", state)
+                    put("stateKnown", stateKnown)
+                    put("progress", manager.getProgress(id).toDouble())
+                    offlineRegionErrors[id]?.let { put("error", it) }
+                }.toString())
+            } catch (error: Throwable) {
+                promise.reject("YANDEX_OFFLINE_STATUS", error)
+            }
+        }
+    }
+
+    override fun startOfflineRegionDownload(regionId: Double, promise: Promise) {
+        UiThreadUtil.runOnUiThread {
+            try {
+                val manager = MapKitFactory.getInstance().offlineCacheManager
+                watchOfflineCatalog(manager)
+                val id = regionId.toInt()
+                logOfflineEvent(manager, id, "start_before", true)
+                if (manager.mayBeOutOfAvailableSpace(id)) {
+                    Log.w("JacoOfflineMap", "event=start_rejected regionId=$id reason=insufficient_space")
+                    promise.reject("YANDEX_OFFLINE_SPACE", "Недостаточно свободного места")
+                    return@runOnUiThread
+                }
+                offlineRegionErrors.remove(id)
+                offlineErrorReleases.remove(id)
+                manager.allowUseCellularNetwork(true)
+                offlineStartedDownloads.remove(id)
+                offlineRequestedDownloads.add(id)
+                offlineActiveDownloads.add(id)
+                manager.startDownload(id)
+                recordOfflineState(manager, id)
+                logOfflineEvent(manager, id, "start_returned", true)
+                promise.resolve(null)
+            } catch (error: Throwable) {
+                offlineRequestedDownloads.remove(regionId.toInt())
+                offlineActiveDownloads.remove(regionId.toInt())
+                Log.e("JacoOfflineMap", "event=start_exception regionId=${regionId.toInt()}", error)
+                promise.reject("YANDEX_OFFLINE_DOWNLOAD", error)
+            }
+        }
+    }
+
+    override fun pauseOfflineRegionDownload(regionId: Double, promise: Promise) {
+        UiThreadUtil.runOnUiThread {
+            try {
+                offlineActiveDownloads.remove(regionId.toInt())
+                offlineRequestedDownloads.remove(regionId.toInt())
+                val manager = MapKitFactory.getInstance().offlineCacheManager
+                manager.pauseDownload(regionId.toInt())
+                logOfflineEvent(manager, regionId.toInt(), "pause_returned", true)
+                promise.resolve(null)
+            } catch (error: Throwable) {
+                promise.reject("YANDEX_OFFLINE_PAUSE", error)
+            }
+        }
+    }
+
+    override fun removeOfflineRegion(regionId: Double, promise: Promise) {
+        UiThreadUtil.runOnUiThread {
+            try {
+                MapKitFactory.getInstance().offlineCacheManager.drop(regionId.toInt())
+                offlineRegionErrors.remove(regionId.toInt())
+                offlineErrorReleases.remove(regionId.toInt())
+                offlineActiveDownloads.remove(regionId.toInt())
+                offlineStartedDownloads.remove(regionId.toInt())
+                offlineRequestedDownloads.remove(regionId.toInt())
+                promise.resolve(null)
+            } catch (error: Throwable) {
+                promise.reject("YANDEX_OFFLINE_REMOVE", error)
+            }
+        }
+    }
