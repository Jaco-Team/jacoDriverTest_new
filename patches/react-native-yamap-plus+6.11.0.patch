+- (void)getOfflineRegionsAtPoint:(double)latitude longitude:(double)longitude resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject {
+    @try {
+        YMKOfflineCacheManager *manager = [YMKMapKit sharedInstance].offlineCacheManager;
+        if (!self.offlineListenersAdded) {
+            [manager addRegionListUpdatesListenerWithRegionListUpdatesListener:self];
+            [manager addErrorListenerWithErrorListener:self];
+            self.offlineListenersAdded = YES;
+        }
+        YMKPoint *point = [YMKPoint pointWithLatitude:latitude longitude:longitude];
+        [manager requestRegionsAtPointWithPoint:point regionsAtPointCallback:^(NSArray<NSNumber *> *regions, NSError *error) {
+            if (error) {
+                reject(@"YANDEX_OFFLINE_REGIONS", error.localizedDescription, error);
+                return;
+            }
+            @try {
+                NSMutableDictionary<NSNumber *, YMKOfflineCacheRegion *> *known = [NSMutableDictionary dictionary];
+                for (YMKOfflineCacheRegion *region in [manager regions]) {
+                    known[@(region.id)] = region;
+                }
+                NSMutableArray *result = [NSMutableArray array];
+                for (NSNumber *regionId in regions ?: @[]) {
+                    NSMutableDictionary *item = [@{
+                        @"id": regionId,
+                        @"name": known[regionId].name ?: [NSString stringWithFormat:@"Регион %@", regionId],
+                        @"catalogCount": @(known.count),
+                        @"catalogUpdated": @(self.offlineCatalogUpdated)
+                    } mutableCopy];
+                    if (self.offlineCatalogError) {
+                        item[@"catalogError"] = self.offlineCatalogError;
+                    }
+                    if (known[regionId]) {
+                        item[@"sizeBytes"] = @(known[regionId].size.value);
+                    }
+                    [result addObject:item];
+                }
+                resolve(offlineJSON(result));
+            } @catch (NSException *exception) {
+                reject(@"YANDEX_OFFLINE_REGIONS", exception.reason, nil);
+            }
+        }];
+    } @catch (NSException *exception) {
+        reject(@"YANDEX_OFFLINE_REGIONS", exception.reason, nil);
+    }
+}
+
+- (void)getOfflineRegionStatus:(double)regionId resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject {
+    @try {
+        YMKOfflineCacheManager *manager = [YMKMapKit sharedInstance].offlineCacheManager;
+        NSUInteger value = (NSUInteger)regionId;
+        resolve(offlineJSON(@{
+            @"id": @(value),
+            @"state": offlineRegionStateName([manager getStateWithRegionId:value]),
+            @"progress": @([manager getProgressWithRegionId:value])
+        }));
+    } @catch (NSException *exception) {
+        reject(@"YANDEX_OFFLINE_STATUS", exception.reason, nil);
+    }
+}
+
+- (void)startOfflineRegionDownload:(double)regionId resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject {
+    @try {
+        YMKOfflineCacheManager *manager = [YMKMapKit sharedInstance].offlineCacheManager;
+        NSUInteger value = (NSUInteger)regionId;
+        if ([manager mayBeOutOfAvailableSpaceWithRegionId:value]) {
+            reject(@"YANDEX_OFFLINE_SPACE", @"Недостаточно свободного места", nil);
+            return;
+        }
+        [manager startDownloadWithRegionId:value];
+        resolve(nil);
+    } @catch (NSException *exception) {
+        reject(@"YANDEX_OFFLINE_DOWNLOAD", exception.reason, nil);
+    }
+}
+
+- (void)pauseOfflineRegionDownload:(double)regionId resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject {
+    @try {
+        [[YMKMapKit sharedInstance].offlineCacheManager pauseDownloadWithRegionId:(NSUInteger)regionId];
+        resolve(nil);
+    } @catch (NSException *exception) {
+        reject(@"YANDEX_OFFLINE_PAUSE", exception.reason, nil);
+    }
+}
