+        [self watchOfflineCatalog:manager];
+        NSUInteger value = (NSUInteger)regionId;
+        NSMutableDictionary *status = [@{
+            @"id": @(value),
+            @"state": offlineRegionStateName([manager getStateWithRegionId:value]),
+            @"progress": @([manager getProgressWithRegionId:value])
+        } mutableCopy];
+        if (self.offlineRegionErrors[@(value)]) status[@"error"] = self.offlineRegionErrors[@(value)];
+        resolve(offlineJSON(status));
+    } @catch (NSException *exception) {
+        reject(@"YANDEX_OFFLINE_STATUS", exception.reason, nil);
+    }
+}
