+static NSString *offlineRegionStateName(YMKOfflineCacheRegionState state) {
+    switch (state) {
+        case YMKOfflineCacheRegionStateAvailable: return @"available";
+        case YMKOfflineCacheRegionStateDownloading: return @"downloading";
+        case YMKOfflineCacheRegionStatePaused: return @"paused";
+        case YMKOfflineCacheRegionStateCompleted: return @"completed";
+        case YMKOfflineCacheRegionStateOutdated: return @"outdated";
+        case YMKOfflineCacheRegionStateUnsupported: return @"unsupported";
+        case YMKOfflineCacheRegionStateNeedUpdate: return @"need_update";
+    }
+    return @"unknown";
+}
+
+static NSString *offlineJSON(id object) {
+    NSData *data = [NSJSONSerialization dataWithJSONObject:object options:0 error:nil];
+    return data ? [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding] : @"[]";
+}
