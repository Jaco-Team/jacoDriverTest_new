+@property (nonatomic, strong) NSMutableDictionary<NSNumber *, NSString *> *offlineRegionErrors;
+@end
+
 @implementation RTNYamapModule

+- (void)watchOfflineCatalog:(YMKOfflineCacheManager *)manager {
+    if (!self.offlineListenersAdded) {
+        [manager addRegionListUpdatesListenerWithRegionListUpdatesListener:self];
+        [manager addErrorListenerWithErrorListener:self];
+        self.offlineListenersAdded = YES;
+    }
+}
+
+- (void)onListUpdated {
+    self.offlineCatalogUpdated = YES;
+    self.offlineCatalogError = nil;
+}
+
+- (void)onErrorWithError:(NSError *)error {
+    self.offlineCatalogError = error.localizedDescription;
+}
+
+- (void)onRegionErrorWithError:(NSError *)error regionId:(NSUInteger)regionId {
+    if (!self.offlineRegionErrors) self.offlineRegionErrors = [NSMutableDictionary dictionary];
+    self.offlineRegionErrors[@(regionId)] = error.localizedDescription;
+}
