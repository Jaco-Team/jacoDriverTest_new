+    @try {
+        YMKOfflineCacheManager *manager = [YMKMapKit sharedInstance].offlineCacheManager;
+        [self watchOfflineCatalog:manager];
+        YMKPoint *point = [YMKPoint pointWithLatitude:latitude longitude:longitude];
+        [manager requestRegionsAtPointWithPoint:point regionsAtPointCallback:^(NSArray<NSNumber *> *regions, NSError *error) {
+            if (error) {
+                reject(@"YANDEX_OFFLINE_REGIONS", error.localizedDescription, error);
+                return;
+            }
+            @try {
+                NSMutableDictionary<NSNumber *, YMKOfflineCacheRegion *> *known = [NSMutableDictionary dictionary];
+                for (YMKOfflineCacheRegion *region in [manager regions]) {
+                    known[@(region.id)] = region;
+                }
+                NSMutableArray *result = [NSMutableArray array];
+                for (NSNumber *regionId in regions ?: @[]) {
+                    NSMutableDictionary *item = [@{
+                        @"id": regionId,
+                        @"name": known[regionId].name ?: [NSString stringWithFormat:@"Регион %@", regionId],
+                        @"catalogCount": @(known.count),
+                        @"catalogUpdated": @(self.offlineCatalogUpdated)
+                    } mutableCopy];
+                    if (self.offlineCatalogError) {
+                        item[@"catalogError"] = self.offlineCatalogError;
+                    }
+                    if (known[regionId]) {
+                        item[@"sizeBytes"] = @(known[regionId].size.value);
+                    }
+                    [result addObject:item];
+                }
+                resolve(offlineJSON(result));
+            } @catch (NSException *exception) {
+                reject(@"YANDEX_OFFLINE_REGIONS", exception.reason, nil);
+            }
+        }];
+    } @catch (NSException *exception) {
+        reject(@"YANDEX_OFFLINE_REGIONS", exception.reason, nil);
+    }
+}
