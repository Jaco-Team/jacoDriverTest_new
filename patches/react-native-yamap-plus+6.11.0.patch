+- (void)startOfflineRegionDownload:(double)regionId resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject {
+    @try {
+        YMKOfflineCacheManager *manager = [YMKMapKit sharedInstance].offlineCacheManager;
+        [self watchOfflineCatalog:manager];
+        NSUInteger value = (NSUInteger)regionId;
+        if ([manager mayBeOutOfAvailableSpaceWithRegionId:value]) {
+            reject(@"YANDEX_OFFLINE_SPACE", @"Недостаточно свободного места", nil);
+            return;
+        }
+        [self.offlineRegionErrors removeObjectForKey:@(value)];
+        [manager allowUseCellularNetworkWithUseCellular:YES];
+        [manager startDownloadWithRegionId:value];
