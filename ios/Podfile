require 'fileutils'

# Resolve react_native_pods.rb with node to allow for hoisting
# require Pod::Executable.execute_command('node', ['-p',
#  'require.resolve(
#    "react-native/scripts/react_native_pods.rb",
#    {paths: [process.argv[1]]},
#  )', __dir__]).strip

def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

$RNFirebaseAsStaticFramework = true
$RNFirebaseDisableSPM = true
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

def cleanup_finder_duplicates!(root_dir)
  return unless Dir.exist?(root_dir)

  Dir.glob(File.join(root_dir, '**', '*'), File::FNM_DOTMATCH)
    .select { |path| File.basename(path).match?(/ 2(\.[^\/]+)?\z/) }
    .sort
    .reverse_each { |path| FileUtils.rm_rf(path) }
end

cleanup_finder_duplicates!(File.join(__dir__, 'Pods'))
cleanup_finder_duplicates!(File.join(__dir__, 'build', 'generated'))

pod 'Firebase', :modular_headers => true
pod 'FirebaseCoreInternal', :modular_headers => true
pod 'GoogleUtilities', :modular_headers => true
pod 'FirebaseCore', :modular_headers => true

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

