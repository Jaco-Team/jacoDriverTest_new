<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 scales the complete 288dp drawable as a system splash icon.
     The transparent outer plate keeps the Jaco logo inside its safe area. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="288dp" android:height="288dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <item
        android:width="112dp"
        android:height="112dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/jaco_splash_logo" />
    </item>
</layer-list>
